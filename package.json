{
  "name": "wreck-it-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/cli",
    "test": "npm test -w packages/cli",
    "typecheck": "npm run typecheck -w packages/cli",
    "eval": "node scripts/eval.mjs --app examples/buggy-app",
    "test:scripts": "node --test scripts/*.test.mjs"
  }
}
