{
  "name": "@miyanishar/wreck-it",
  "version": "0.2.0",
  "description": "AI QA testing for local web apps: your coding agent tests user flows, hostile inputs, accessibility and load, then reports reproduced bugs with code locations.",
  "keywords": [
    "qa",
    "testing",
    "ai-testing",
    "e2e",
    "playwright",
    "browser-testing",
    "regression-testing",
    "accessibility",
    "load-testing",
    "claude-code",
    "codex",
    "cursor",
    "agent-skills",
    "coding-agent"
  ],
  "type": "module",
  "bin": {
    "wreck-it": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "autocannon": "^8.0.0",
    "axe-core": "^4.13.0",
    "commander": "^14.0.0",
    "lighthouse": "^13.5.0",
    "playwright": "^1.63.0",
    "zod": "^4.6.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.0",
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.0",
    "vitest": "^5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miyannishar/wreck-it.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/miyannishar/wreck-it#readme"
}
